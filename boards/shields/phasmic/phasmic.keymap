#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define BLE 1
#define SWAP 2
#define UTIL 3
#define UTIL2 4
#define FUNCNO 5
#define CMD 6
#define OPT 7
#define MATHS 8
#define THUMB1 9

/ {

   // Activate ADJUST layer by pressing raise and lower
    conditional_layers {
        compatible = "zmk,conditional-layers";
    };

    macros {
        macro_maths: macro_maths {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp BSLH &kp LPAR  &kp BSLH &kp RPAR &kp LEFT  &kp LEFT>;
        };

        macro_maths_pow: macro_maths_pow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp CARET &kp LBRC &kp RBRC &kp LEFT>;
        };

        macro_maths_under: macro_maths_under {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp UNDER &kp LBRC &kp RBRC &kp LEFT>;
        };

        macro_maths_frac: macro_maths_frac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp BSLH &kp F &kp R &kp A &kp C  &kp LBRC &kp RBRC  &kp LBRC &kp RBRC &kp LEFT &kp LEFT &kp LEFT>;
        };

        macro_maths_int: macro_maths_int {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp BSLH &kp I &kp N &kp T &kp UNDER  &kp LBRC &kp RBRC  &kp CARET &kp LBRC &kp RBRC &kp LEFT &kp LEFT &kp LEFT &kp LEFT>;
        };

        macro_maths_rarrow: macro_maths_rarrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp BSLH>,<&macro_press &kp LSHFT>,<&macro_tap &kp R>,<&macro_release &kp LSHFT>,<&macro_tap &kp I &kp G &kp H &kp T &kp A &kp R &kp R &kp O &kp W &kp SPACE>;
        };

        macro_maths_larrow: macro_maths_larrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp BSLH>,<&macro_press &kp LSHFT>,<&macro_tap &kp L>,<&macro_release &kp LSHFT>,<&macro_tap &kp E &kp F &kp T &kp A &kp R &kp R &kp O &kp W &kp SPACE>;
        };

        macro_maths_lrarrow: macro_maths_lrarrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp BSLH>,<&macro_press &kp LSHFT>,<&macro_tap &kp L>,<&macro_release &kp LSHFT>,<&macro_tap &kp E &kp F &kp T &kp R &kp I &kp G &kp H &kp T &kp A &kp R &kp R &kp O &kp W &kp SPACE>;
        };

        macro_vscode_build: macro_vscode_build {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = 
                <&macro_press &kp LGUI>,
                <&macro_press &kp LALT>,
                <&macro_tap &kp B>,
                <&macro_release &kp LALT>,
                <&macro_release &kp LGUI>;
        };

        macro_alt_backspace: macro_alt_backspace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp BSPC>
                , <&macro_release &kp LALT>
                ;
        };

        macro_par: macro_par {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LPAR &kp RPAR &kp LEFT>;
        };

        macro_bkt: macro_bkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LBKT &kp RBKT &kp LEFT>;
        };

        macro_brc: macro_brc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LBRC &kp RBRC &kp LEFT>;
        };

        macro_apos: macro_apos {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp APOS &kp APOS &kp LEFT>;
        };

        macro_dqt: macro_dqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp DQT &kp DQT &kp LEFT>;
        };

        hold_two: hold_two {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;

            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&kp LSHIFT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LCTRL>,
                <&kp LSHIFT>;
        };

        macro_left: macro_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = 
                <&macro_press &kp LALT>,
                <&macro_tap &kp LEFT>,
                <&macro_release &kp LALT>;
        };

        macro_lleft: macro_lleft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT>;
        };

        macro_right: macro_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = 
                <&macro_press &kp LALT>,
                <&macro_tap &kp RIGHT>,
                <&macro_release &kp LALT>;
        };


        macro_rright: macro_rright {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp RIGHT &kp RIGHT &kp RIGHT &kp RIGHT &kp RIGHT &kp RIGHT &kp RIGHT &kp RIGHT &kp RIGHT &kp RIGHT>;
        };

        macro_supercpy: macro_supercpy { //super copy, works for mac, win, ubun
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = 
                <&macro_press &kp LCTRL>,
                <&macro_press &kp LSHFT>,
                <&macro_tap &kp C>,
                <&macro_release &kp LSHFT>,
                <&macro_release &kp LCTRL>;
        };

        macro_superpst: macro_superpst {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                =     
                <&macro_press &kp LCTRL>,
                <&macro_press &kp LSHFT>,
                <&macro_tap &kp V>,
                <&macro_release &kp LSHFT>,
                <&macro_release &kp LCTRL>;
        };

        macro_redo: macro_redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(LS(Z))>,
                <&kp LG(Y)>;
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo UTIL>, <&mo MATHS>;
        };

        macro_sall: macro_sall {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = 
                <&macro_press &kp LGUI>,
                <&macro_tap &kp A>,
                <&macro_release &kp LGUI>;
        };
        tdCmd: tap_dance_cmd {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <500>;
            bindings = <&kp LGUI>, <&mo CMD>;
        };

        tdLCtrl: tap_dance_lctrl {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <500>;
            bindings = <&kp LCTRL>, <&mo UTIL>;
        };

        tdOpt: tap_dance_opt {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <500>;
            bindings = <&kp LALT>, <&mo OPT>;
        };

        tdSwMth: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo SWAP>, <&mo MATHS>;
        };

        tdSwpDir: tap_dance_swp_dir {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo SWAP>, <&mo UTIL>;
        };

        macro_mathbb: macro_mathbb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp BSLH &kp M &kp A &kp T &kp H &kp B &kp B &kp SPACE>;
        };

        macro_mathbrc: macro_mathbrc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp BSLH &kp LBRC &kp BSLH &kp RBRC &kp LEFT &kp LEFT>;
        };

        macro_vscview: macro_vscview {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings  =
                <&macro_press &kp LGUI>,
                <&macro_press &kp LALT>,
                <&macro_tap &kp V>,
                <&macro_release &kp LALT>,
                <&macro_release &kp LGUI>,

                <&macro_press &kp LGUI>,
                <&macro_press &kp LSHIFT>,
                <&macro_tap &kp V>,
                <&macro_release &kp LSHIFT>,
                <&macro_release &kp LGUI>;
        };

        tdU12: tap_dance_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo UTIL>, <&mo UTIL2>;
        };

        tdBTU3: tap_dance_4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo BLE>, <&mo FUNCNO>;
        };

    };

    /*
    *   Thumb column mappings:
    *   1 2 3 4 5 6 || 12 11 10 9 8 7
    */

    keymap {
        compatible = "zmk,keymap";

    default_layer {
        display-name = "default";
        bindings = <
            &lt MATHS ESC   &kp N1      &kp N2      &kp N3          &kp N4    &kp N5        &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp EQUAL
            &lt UTIL2 TAB   &kp Q       &kp W       &kp E           &kp R     &kp T         &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSLH
            &kp RET         &kp A       &kp S       &lt THUMB1 D    &kp F     &kp G         &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
            &sk LSHIFT      &kp Z       &kp X       &kp C           &kp V     &lt UTIL B    &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
            &mo UTIL2       &tdSwpDir   &tdCmd      &kp SPACE       &none     &none         &kp N1    &kp N3    &kp N5    &none     &kp N9    &kp EQUAL
            &mo BLE         &tdOpt      &tdLCtrl    &kp BSPC        &none     &none         &kp A     &kp B     &kp C     &kp D     &kp E     &kp F
        >;
    };

    ble_layer {
        display-name = "BLE";
        bindings = <
            &bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none  &none  &none  &none  &none  &none
            &bt BT_CLR_ALL  &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4 &none  &none  &none  &none  &none  &none
            &kp F1          &kp F2        &kp F3        &kp F4        &kp F5        &kp F6        &none  &none  &none  &none  &none  &none
            &kp F7          &kp F8        &kp F9        &kp F10       &kp F11       &kp F12       &none  &none  &none  &none  &none  &none
            &none           &none         &none         &none         &none         &none         &none  &none  &none  &none  &none  &none
            &none           &none         &none         &none         &none         &none         &none  &none  &none  &none  &none  &none
        >;
    };

    swap {
        display-name = "SWAP";
        bindings = <
            &kp EQUAL  &kp N0   &kp N9   &kp N8     &kp N7  &kp N6   &kp N5   &kp N4   &kp N3   &kp N2   &kp N1   &kp ESC
            &kp BSLH   &kp P    &kp O    &kp I      &kp U   &kp Y    &kp T    &kp R    &kp E    &kp W    &kp Q    &kp TAB
            &kp SQT    &kp SEMI &kp L    &kp K      &kp J   &kp H    &kp G    &kp F    &kp D    &kp S    &kp A    &kp RET
            &kp RSHFT  &kp FSLH &kp DOT  &kp COMMA  &kp M   &kp N    &kp B    &kp V    &kp C    &kp X    &kp Z    &kp LSHFT
            &none      &none    &none    &none      &none   &none    &none    &none    &none    &none    &none    &none
            &none      &none    &none    &none      &none   &none    &none    &none    &none    &none    &none    &none
        >;
    };

    util {
        display-name = "UTIL";
        bindings = <
            &kp GRAVE   &kp TILDE   &macro_lleft    &none       &macro_rright           &none       &none     &none       &none       &none       &none       &none
            &kp MINUS   &kp PLUS    &macro_left     &kp UP      &macro_right   &none       &none     &none       &none       &none       &none       &none
            &none       &kp LALT    &kp LEFT        &kp DOWN    &kp RIGHT       &none       &none     &kp LGUI    &kp LALT    &none       &none       &none
            &none       &macro_redo &none           &none       &macro_vscview  &macro_vscode_build &none   &none   &none   &none   &none   &none
            &none       &none       &kp DEL         &none       &none           &none       &none     &none       &none       &none       &none       &none
            &none       &none       &none           &none       &none           &none       &none     &none       &none       &none       &none       &none
        >;
    };

    util2 {
        display-name = "UTIL2";
        bindings = <
            &none &none &none      &macro_brc &kp LBRC    &kp RBRC   &none &none &none &none &none &none
            &none &none &none      &macro_bkt &kp LBKT    &kp RBKT   &none &none &none &none &none &none
            &none &none &none      &macro_par &kp LPAR    &kp RPAR   &none &none &none &none &none &none
            &none &none &none      &none      &none       &none      &none &none &none &none &none &none
            &none &none &none      &none      &none       &none      &none &none &none &none &none &none
            &none &none &none      &kp DEL    &none       &none      &none &none &none &none &none &none
        >;
    };

    funcNo {
        display-name = "FUNCNO";
        bindings = <
            &kp F1  &kp F2      &kp F3  &kp F4  &kp F5  &kp F6  &none   &none   &none   &none   &none   &none
            &kp F7  &kp F8      &kp F9  &kp F10 &kp F11 &kp F12 &none   &none   &none   &none   &none   &none
            &none   &none       &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
            &none   &none       &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
            &none   &none       &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
            &none   &none       &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
        >;
    };

    cmd {
        display-name = "CMD";
        bindings = <
            &kp GRAVE   &kp TILDE   &macro_lleft    &none           &macro_rright           &none       &none     &none       &none       &none       &none       &none
            &kp MINUS   &kp PLUS    &macro_left     &kp UP          &macro_right   &none       &none     &none       &none       &none       &none       &none
            &none       &kp LALT    &kp LEFT        &kp DOWN        &kp RIGHT       &none       &none     &kp LGUI    &kp LALT    &none       &none       &none 
            &none       &macro_redo &kp UNDER       &macro_supercpy &macro_superpst &none       &none     &none       &none       &none       &none       &none
            &none       &none       &none           &none           &none           &none               &none   &none   &none   &none   &none   &none
            &none       &none       &none           &none           &none           &none               &none   &none   &none   &none   &none   &none
        >;
    };

    opt {
        display-name = "OPT";
        bindings = <
            &none   &macro_mathbb       &macro_mathbrc          &macro_maths    &macro_maths_frac   &macro_maths_under  &none  &none                &none                 &none                  &none  &none
            &none   &none               &macro_maths_larrow     &kp PLUS        &kp STAR            &macro_maths_pow    &none  &none                &none                 &none                  &none  &none
            &none   &none               &macro_maths_rarrow     &kp MINUS       &kp FSLH            &macro_maths_int    &none  &macro_maths_larrow  &macro_maths_lrarrow  &macro_maths_rarrow    &none  &none
            &none   &none               &macro_maths_lrarrow    &kp EQUAL       &none               &macro_vscode_build &none  &none                &none                 &none                  &none  &none
            &none   &none               &none                   &none           &none               &none               &none  &none                &none                 &none                  &none  &none
            &none   &none               &none                   &none           &none               &none               &none  &none                &none                 &none                  &none  &none
        >;
    };

    maths {
        display-name = "MATHS";
        bindings = <
            &none   &macro_mathbb       &macro_mathbrc    &macro_maths    &macro_maths_frac   &macro_maths_under  &none  &none                &none                 &none                  &none  &none
            &none   &none               &none             &kp PLUS        &kp STAR            &macro_maths_pow    &none  &none                &none                 &none                  &none  &none
            &none   &none               &none             &kp MINUS       &kp FSLH            &macro_maths_int    &none  &macro_maths_larrow  &macro_maths_lrarrow  &macro_maths_rarrow    &none  &none
            &none   &none               &none             &kp EQUAL       &none               &macro_vscode_build &none  &none                &none                 &none                  &none  &none
            &none   &none               &none             &none           &none               &none               &none  &none                &none                 &none                  &none  &none
            &none   &none               &none             &none           &none               &none               &none  &none                &none                 &none                  &none  &none
        >;
    };

    thumb1 {
        display-name = "THUMB1";
        bindings = <
            &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
            &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
            &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
            &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
            &kp UNDER   &kp MINUS   &kp LG(EQUAL)   &kp UNDER  &none     &none     &none     &none     &none     &none     &none     &none
            &kp MINUS   &macro_par  &kp LG(MINUS)  &kp DEL  &none &none     &none     &none     &none     &none     &none     &none
        >;
    };
    };
};
